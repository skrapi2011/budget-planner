# Virtual environments
**/venv/
**/.venv/
env/
.venv/

# Python
**/__pycache__/
**/*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Byte-compiled / optimized
**/*.pyc

# pytest
.pytest_cache/

# Node.js frontend
frontend/node_modules/
frontend/dist/
# Probe builds (vite lib-mode bundles used for jsdom smoke tests) — build output,
# never committed. Without this `npm run lint` (eslint .) lints a 2.7 MB bundle.
frontend/dist_probe/

# Database
backend/data/baza.db
backend/data/*.db
# The generated JWT secret (App.py persists it next to the DB, mode 0600) — machine state, never
# committed. A # mid-line is part of a gitignore pattern, so the note stays on its own line.
backend/data/.jwt_secret
!backend/data/.gitkeep

# pi session artifacts
backend/.pi/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.vs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Git
.gitignore.*

# Env files hold SECRET_KEY / ALLOWED_ORIGINS / VITE_API_URL. Vite reads .env.local etc. and a committed
# .env in a public repo leaks the JWT signing key to every clone.
.env
.env.local
.env.*.local
.env.development
.env.production
